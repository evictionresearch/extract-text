# Never commit real court records or anything extracted from them.
data/
*.pdf
*.csv
*.parquet
*.tsv
!python/tests/fixtures/synthetic_*

# Validation game decks. Card crops are images of real filings, roughly 18 KB
# each, so a full deck runs to several megabytes of court records. Decks live
# in the governed data tree and are never committed. `game/demo/` is rebuilt from
# the synthetic fixtures by game/make_demo_deck.py, so it is not committed
# either and the repo carries no card images at all.
game/demo/
game/crops/
game/deck.json
game/gold.csv
**/deck.json
**/cards.csv
**/gold.csv

# Credentials
.env
.Renviron
*.pem

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
r/src/*.o
r/src/*.so

# OS
.DS_Store

# Claude Code personal settings (the model-watch hook); not team config
.claude/settings.local.json

# The multi-document bench corpus (python/scripts/make_corpus.py). 11 MB of
# PNGs, fully deterministic, so it is regenerated on demand rather than
# carried in the repository. The small degraded/ set stays tracked as the
# quick smoke test.
python/tests/fixtures/corpus/

# Scan outputs and grading bundles. A scan run with --out inside the repo
# would otherwise leave these one `git add` away from a commit.
*.jsonl
*.zip
review/
